# ==========================================
# Telegram Bot Configuration
# ==========================================
# Get your BOT token from @BotFather on Telegram
TELEGRAM_BOT_TOKEN=your_bot_token_here

# Get your Chat ID from @userinfobot or @RawDataBot (can be a user ID or group/channel ID like -100...)
TELEGRAM_CHAT_ID=your_chat_id_here

# ==========================================
# Scanner Options (Optional defaults)
# ==========================================
# Minimum ROI edge to report (0.01 = 1%, 0.02 = 2%, 0 = all)
MIN_ROI=0.01

# Bankroll for stake split calculations (in dollars/currency)
BANKROLL=100

# Event start time window in hours (default: 24)
HOURS=24

# Whether to send a message when 0 arbs are found (true/false)
# Set to false if you only want Telegram alerts when arbs actually exist
SEND_EMPTY_REPORT=false

# Timezone for displaying event start times
TIMEZONE=America/Edmonton
